# Copy to .env (git-ignored). Any value can be a 1Password secret reference
# (op://vault/item/field) when you start the stack with:
#   op run --env-file=".env" -- docker compose up -d

# Match your host user (`id -u` / `id -g`).
# USER_UID=1000
# USER_GID=1000

# Git identity.
GIT_AUTHOR_NAME=op://vault/item/field
GIT_AUTHOR_EMAIL=op://vault/item/field
GIT_COMMITTER_NAME=op://vault/item/field
GIT_COMMITTER_EMAIL=op://vault/item/field

# Used by the gh CLI and by git over HTTPS.
GH_TOKEN=op://vault/item/field

# Amazon Bedrock. Uncomment to use Claude through Bedrock instead of a
# Claude account login.
# CLAUDE_CODE_USE_BEDROCK=1
# AWS_REGION=ap-southeast-2
# AWS_BEARER_TOKEN_BEDROCK=op://vault/item/field
